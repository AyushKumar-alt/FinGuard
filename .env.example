# FinGuard Environment Configuration
# Copy this file to .env and configure local settings

# Application Environment
FINGUARD_ENV=development
LOG_LEVEL=INFO

# Data & Model Paths
FINFACT_DATA_PATH=finfact.json
BASELINE_MODEL_PATH=outputs/best_baseline_model.pkl
P1_INDEX_PATH=outputs/p1_positional_index.json

# Offline Execution Controls (Set to 1 for sandboxed/offline environments)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Server Ports
API_PORT=8000
STREAMLIT_PORT=8501
FRONTEND_PORT=3000

